{% comment %}
  ============================================================
  Section: Gift Guide Banner
  ============================================================
  Custom Shopify section built from scratch (not reusing any
  existing Dawn / Horizon sections).

  Layout:
    • Top announcement bar — logo, subtitle, "Choose Gift" CTA
    • Hero area — heading, description, "Shop Now" CTA over a
      full-width background illustration
    • Bottom announcement bar — sustainability tagline

  All text fields are editable via the Theme Customiser.
  ============================================================
{% endcomment %}

{%- comment -%} ── Load fonts + stylesheet ── {%- endcomment -%}
{{ 'gift-guide.css' | asset_url | stylesheet_tag }}

<style>
  /* Import Google Fonts — Jost (body) + Lustria (headings) */
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Lustria&display=swap');
</style>

<section class="gg-section gg-banner" aria-label="{{ section.settings.heading }}">

  {%- comment -%} ── TOP ANNOUNCEMENT BAR (desktop) ── {%- endcomment -%}
  <div class="gg-bar gg-bar--top">
    {%- comment -%} Brand logo SVG {%- endcomment -%}
    <img
      class="gg-bar__logo"
      src="{{ 'gift-guide-logo.svg' | asset_url }}"
      alt="{{ section.settings.brand_name | escape }}"
      width="151"
      height="19"
      loading="eager"
    >

    {%- comment -%} Centre subtitle text {%- endcomment -%}
    <span class="gg-bar__text">{{ section.settings.subtitle }}</span>

    {%- comment -%} "Choose Gift" yellow CTA {%- endcomment -%}
    <a
      class="gg-btn-choose"
      href="{{ section.settings.cta_choose_link }}"
      aria-label="{{ section.settings.cta_choose_text }}"
    >
      {{ section.settings.cta_choose_text }}
      <svg class="gg-btn-choose__arrow" width="24" height="2" viewBox="0 0 24 2" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 1H24" stroke="currentColor" stroke-width="1.5"/>
        <path d="M18 0L24 1L18 2" fill="currentColor"/>
      </svg>
    </a>
  </div>

  {%- comment -%} ── MOBILE HEADER ── {%- endcomment -%}
  <div class="gg-mobile-header" id="gg-mobile-header">
    <div class="gg-mobile-header__main">
      <button class="gg-mobile-header__hamburger" id="gg-mobile-menu-trigger" aria-label="Toggle menu">
        <img
          class="gg-mobile-header__icon-open"
          src="{{ 'gift-guide-hamburger.svg' | asset_url }}"
          alt="Menu"
          width="18"
          height="10"
          loading="eager"
        >
        <svg class="gg-mobile-header__icon-close" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
          <path d="M1 1L15 15M15 1L1 15" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <img
        class="gg-mobile-header__logo"
        src="{{ 'gift-guide-logo.svg' | asset_url }}"
        alt="{{ section.settings.brand_name | escape }}"
        width="151"
        height="19"
        loading="eager"
      >
    </div>
    <div class="gg-mobile-header__dropdown" id="gg-mobile-menu-dropdown">
      <span class="gg-mobile-header__text">{{ section.settings.subtitle }}</span>
      <a
        class="gg-btn-choose gg-mobile-header__btn"
        href="{{ section.settings.cta_choose_link }}"
        aria-label="{{ section.settings.cta_choose_text }}"
      >
        {{ section.settings.cta_choose_text }}
        <svg class="gg-btn-choose__arrow" width="24" height="2" viewBox="0 0 24 2" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H24" stroke="currentColor" stroke-width="1.5"/>
          <path d="M18 0L24 1L18 2" fill="currentColor"/>
        </svg>
      </a>
    </div>
  </div>

  {%- comment -%} ── HERO AREA ── {%- endcomment -%}
  <div class="gg-hero">
    {%- comment -%} Background illustration (SVG or custom image) {%- endcomment -%}
    {%- if section.settings.banner_image != blank -%}
      <img
        class="gg-hero__bg"
        src="{{ section.settings.banner_image | image_url: width: 1440 }}"
        alt=""
        role="presentation"
        width="1440"
        height="780"
        loading="eager"
      >
    {%- else -%}
      <img
        class="gg-hero__bg"
        src="{{ 'gift-guide-banner-bg.svg' | asset_url }}"
        alt=""
        role="presentation"
        width="1440"
        height="780"
        loading="eager"
      >
    {%- endif -%}

    {%- comment -%} Hero Content {%- endcomment -%}
    <div class="gg-hero__content">
      <h1 class="gg-hero__heading">{{ section.settings.heading }}</h1>
      <p class="gg-hero__description gg-hide-mobile">{{ section.settings.description }}</p>
      <p class="gg-hero__description gg-hide-desktop">{{ section.settings.description_mobile | default: section.settings.description }}</p>

      {%- comment -%} Desktop CTA {%- endcomment -%}
      <a
        class="gg-btn-shop"
        href="{{ section.settings.cta_link }}"
        aria-label="{{ section.settings.cta_text }}"
      >
        {{ section.settings.cta_text }}
        <svg class="gg-btn-shop__arrow" width="25" height="2" viewBox="0 0 25 2" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H25" stroke="white" stroke-width="1.5"/>
          <path d="M19 0L25 1L19 2" fill="white"/>
        </svg>
      </a>

      {%- comment -%} Mobile CTA (different position in the layout) {%- endcomment -%}
      <a
        class="gg-btn-shop gg-hero__cta-mobile"
        href="{{ section.settings.cta_link }}"
        aria-label="{{ section.settings.cta_text }}"
      >
        {{ section.settings.cta_text }}
        <svg class="gg-btn-shop__arrow" width="24" height="2" viewBox="0 0 24 2" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H24" stroke="white" stroke-width="1.5"/>
          <path d="M18 0L24 1L18 2" fill="white"/>
        </svg>
      </a>
    </div>
  </div>

  {%- comment -%} ── BOTTOM ANNOUNCEMENT BAR ── {%- endcomment -%}
  <div class="gg-bar gg-bar--bottom">
    <span class="gg-bar__text gg-hide-mobile">{{ section.settings.bottom_text }}</span>
    <span class="gg-bar__text gg-hide-desktop">{{ section.settings.bottom_text_mobile | default: section.settings.bottom_text }}</span>
  </div>

</section>

{% comment %}
  ============================================================
  Schema — Customiser settings for the Banner section
  ============================================================
{% endcomment %}
{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "div",
  "class": "gift-guide-banner-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Top Bar Subtitle",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "cta_choose_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "cta_choose_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image",
      "info": "Leave blank to use the default SVG illustration."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "description_mobile",
      "label": "Hero Description (Mobile)",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Bar Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "bottom_text_mobile",
      "label": "Bottom Bar Text (Mobile)",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
